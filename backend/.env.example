# All variables are optional. Without LLM_API_KEY the app runs in deterministic rules mode.
# The backend reads the process environment, e.g.: export $(grep -v '^#' .env | xargs)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
CRM_TODAY=2026-09-01
# CRM_DB_PATH=data/crm.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
